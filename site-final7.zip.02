<div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-labelledby="ovName">
  <div class="overlay-top">
    <span class="crumb">The Unreal Human / Profile</span>
    <button class="close-btn" id="ovClose"><span class="x">&times;</span> Close</button>
  </div>
  <div class="overlay-body">
    <div class="profile-hero">
      <div class="profile-hero-text">
        <h2 id="ovName"></h2>
        <p class="niche" id="ovNiche"></p>
        <p class="specs" id="ovSpecs"><span id="ovHeight"></span><span id="ovGender">FEMALE</span><span id="ovAge"></span><span id="ovEthnicity"></span><span id="ovBased"></span></p>
      </div>
      <div class="profile-hero-media">
        <img class="profile-hero-img" id="ovHero" alt="" />
      </div>
    </div>
    <img class="main-img" id="ovMain" alt="" />
    <video class="main-video" id="ovVideo" muted loop playsinline autoplay controls preload="metadata" hidden></video>
    <p class="story" id="ovStory"></p>
    <p class="tags-label" id="ovTagsLabel">Best for brands</p>
    <p class="tags" id="ovTags"></p>
    <a class="book-cta" href="#book" id="ovBook">Book this model</a>
    <p class="gal-label" id="ovGalLabel">Gallery</p>
    <div class="gal" id="ovGal"></div>
    <p class="gal-label work-label" id="ovWorkLabel" hidden>Work</p>
    <div class="gal work-gal" id="ovWork"></div>
  </div>
</div>

<!-- Frosted-glass lightbox: opens a work photo at full clarity -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button class="lb-close" id="lbClose" aria-label="Close photo viewer"><span class="x">&times;</span> Close</button>
  <button class="lb-nav lb-prev" id="lbPrev" aria-label="Previous photo">&#8249;</button>
  <figure class="lb-frame">
    <img class="lb-img" id="lbImg" alt="" />
    <figcaption class="lb-bar">
      <span class="lb-cap" id="lbCap"></span>
      <span class="lb-count" id="lbCount"></span>
    </figcaption>
  </figure>
  <button class="lb-nav lb-next" id="lbNext" aria-label="Next photo">&#8250;</button>
</div>

<script>
(function(){
  "use strict";
  var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var finePointer = !!(window.matchMedia && window.matchMedia("(pointer: fine)").matches);

  var MODELS = {
    vaani: {
      name: "Vaani Garg",
      height: "5'6\"",
      gender: "FEMALE",
      age: "24",
      ethnicity: "Indian",
      based: "India",
      niche: "Editorial Beauty · Ethnic Fashion",
      feature: "data:image/webp;base64,",
      featureAlt: "Vaani Garg in a grey distressed cut-out top, studio portrait with the background removed",
      main: "data:image/jpeg;base64,",
      mainAlt: "Vaani Garg in a red and green embroidered saree",
      story: "She has the kind of face a camera settles on — auburn hair pulled back, skin left real, a gaze that stays calm and direct. In the studio she is all clean lines and quiet confidence; in a red-and-green embroidered saree she turns festive and rich without changing who she is. That range is exactly what beauty and fashion brands need: one face that can carry both the minimal campaign and the celebration.",
      tags: ["Beauty & skincare", "Ethnic & festive fashion", "Jewellery", "Editorial campaigns"],
