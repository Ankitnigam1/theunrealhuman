", "Caroline Langford in a sequin butterfly top and jeans, studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, back view showing her long curly hair, studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford, white-background studio portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford in a red dress at a restaurant"],
        ["data:image/jpeg;base64,", "Caroline Langford, red dress portrait at the table"],
        ["data:image/jpeg;base64,", "Caroline Langford in a garden gown holding a basket of roses"],
        ["data:image/jpeg;base64,", "Caroline Langford among garden roses"],
        ["data:image/jpeg;base64,", "Caroline Langford dining, red dress"],
        ["data:image/jpeg;base64,", "Caroline Langford, garden gown close portrait"],
        ["data:image/jpeg;base64,", "Caroline Langford standing in a red evening dress"]
      ]
    }
  };

  /* ---------- header ---------- */
  var header = document.getElementById("siteHeader");
  var headerTick = false;
  function onScroll(){
    /* Scroll events can fire far faster than the screen refreshes;
       coalesce them into one class toggle per animation frame. */
    if (headerTick) return;
    headerTick = true;
    requestAnimationFrame(function(){
      headerTick = false;
      header.classList.toggle("scrolled", window.scrollY > window.innerHeight * 0.82);
    });
  }
  window.addEventListener("scroll", onScroll, { passive:true });
  onScroll();

  /* ---------- reveal on scroll ---------- */
  var cells = Array.prototype.slice.call(document.querySelectorAll(".reveal"));
  if (reduced || !("IntersectionObserver" in window)){
    cells.forEach(function(c){ c.classList.add("in"); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    cells.forEach(function(c){ io.observe(c); });
    /* fallback: never leave a portrait hidden if the observer does not fire */
    setTimeout(function(){ cells.forEach(function(c){ c.classList.add("in"); }); }, 600);
  }

  /* ---------- filters ---------- */
  var filterBtns = Array.prototype.slice.call(document.querySelectorAll(".filters button"));
  filterBtns.forEach(function(btn){
    btn.addEventListener("click", function(){
      filterBtns.forEach(function(b){ b.classList.toggle("active", b === btn); });
      var f = btn.getAttribute("data-filter");
      cells.forEach(function(c){
        var show = (f === "all" || c.getAttribute("data-cat") === f);
        c.classList.toggle("hide", !show);
        if (show) c.classList.add("in");
      });
      Array.prototype.forEach.call(document.querySelectorAll(".model-row"), function(r){
        var rShow = (f === "all" || r.getAttribute("data-cat") === f);
        r.classList.toggle("hide", !rShow);
      });
      if (typeof refreshStage === "function") refreshStage(f !== "all");
    });
  });

  /* ---------- 360 frame turntables ----------
     Frame-based, not video-based: seeking a paused video is unreliable on
     iOS Safari, so dragging swaps preloaded still frames instead.
     Turntables live in exactly two places: the hero slider (landscape
     frame sets) and the 3D stage below it (Vaani pink + denim, Ankit
     leather head-to-thighs, Shreya cream lace full body, Caroline
     sequin). The profiles have no
     turntables or turn videos â€” photos only. */
  function frameUrls(dir, count){
    var urls = [];
    for (var i = 1; i <= count; i++){
      urls.push(dir + "/frame-" + (i < 10 ? "0" : "") + i + ".jpg");
    }
    return urls;
  }
  var VAANI_PINK_URLS = frameUrls("assets/vaani-thigh-frames", 60);
  var ANKIT_LEATHER_URLS = frameUrls("assets/ankit-thigh-frames", 60);
  var CAROLINE_URLS = frameUrls("assets/caroline-thigh-frames", 60);
  var SHREYA_CREAM_URLS = frameUrls("assets/shreya-thigh-frames", 48);
  /* Lazy per-look loading: a look's frames are fetched only the first time
     that look is selected, then cached. Every frame fetch goes through
     one small queue (at most 4 in flight) so warming a turntable can
     never flood the connection or the image decoder the way firing
     ~170 Image() loads at once did - that flood was the main cause
     of the lag. warmGridFrames() runs on load, when the stage
     scrolls near, or on a 15s fallback - and a turntable dragged
     before its frames land simply streams them on demand. */
  var frameCache = {};
  var frameQueue = [], frameLoading = 0;
  function pumpFrameQueue(){
    while (frameLoading < 4 && frameQueue.length){
      var u = frameQueue.shift();
      frameLoading++;
      var im = new Image();
      im.decoding = "async";
      var done = function(){ frameLoading--; pumpFrameQueue(); };
      im.onload = done;
      im.onerror = done;
      im.src = u;
    }
  }
  function queueFrames(urls){
    urls.forEach(function(u){ frameQueue.push(u); });
    pumpFrameQueue();
  }
  function ensureFrames(key, urls){
    if (frameCache[key]) return;
    frameCache[key] = true;
    queueFrames(urls);
  }
  var gridFramesWarmed = false;
  function warmGridFrames(){
    if (gridFramesWarmed) return;
    gridFramesWarmed = true;
    ensureFrames("vaani-pink", VAANI_PINK_URLS);
    ensureFrames("ankit-leather", ANKIT_LEATHER_URLS);
    ensureFrames("caroline-full", CAROLINE_URLS);
    ensureFrames("shreya-cream-full", SHREYA_CREAM_URLS);
  }
  if ("IntersectionObserver" in window){
    var gridWarmIO = new IntersectionObserver(function(en){
      if (en[0].isIntersecting){ warmGridFrames(); gridWarmIO.disconnect(); }
    }, { rootMargin: "700px 0px" });
    var stageWarmEl = document.getElementById("stage");
    if (stageWarmEl) gridWarmIO.observe(stageWarmEl);
  }
  setTimeout(warmGridFrames, 15000);
  function angleName(deg){
    if (deg < 45 || deg >= 315) return "front";
    if (deg < 135 || deg >= 225) return "profile";
    return "back";
  }
  function attachTurntable(wrap, img, urls, onAngle){
    var pos = 0, lastIdx = -1, dragging = false, startX = 0, startPos = 0, moved = 0;
    var playTimer = null;
    var inertiaRaf = null, samples = [], ttVisible = true;
    function count(){ return urls.length; }
    function curIdx(){ var c = count(); return ((Math.round(pos) % c) + c) % c; }
    function render(){
      var idx = curIdx();
      if (idx !== lastIdx){ lastIdx = idx; img.src = urls[idx]; }
      var deg = Math.round(idx / count() * 360) % 360;
      wrap.setAttribute("aria-valuenow", deg);
      var nm = angleName(deg);
      wrap.setAttribute("aria-valuetext", nm.charAt(0).toUpperCase() + nm.slice(1) + " view");
      if (onAngle) onAngle(nm);
    }
    function stopInertia(){
      if (inertiaRaf){ cancelAnimationFrame(inertiaRaf); inertiaRaf = null; }
    }
    function stopPlay(){
      if (playTimer){ clearInterval(playTimer); playTimer = null; }
      stopInertia();
    }
    /* Momentum: after a flick the turn keeps gliding and settles gently
       (exponential decay) instead of stopping dead. No motion at all when
       the turntable is untouched, and none for reduced motion. */
    function startInertia(v0){
      if (reduced) return;
      var v = Math.max(-0.14, Math.min(0.14, v0));
      if (Math.abs(v) < 0.012) return;
      stopInertia();
      var lastT = performance.now();
      function step(now){
        var dt = Math.min(50, now - lastT); lastT = now;
        if (!ttVisible){ inertiaRaf = null; return; }
        pos += v * dt;
        v *= Math.exp(-dt / 170);
        render();
        if (Math.abs(v) > 0.004){ inertiaRaf = requestAnimationFrame(step); }
        else { inertiaRaf = null; pos = Math.round(pos); render(); }
      }
      inertiaRaf = requestAnimationFrame(step);
    }
    if ("IntersectionObserver" in window){
      new IntersectionObserver(function(en){
        ttVisible = en[0].isIntersecting;
        if (!ttVisible) stopInertia();
      }, { threshold: 0.05 }).observe(wrap);
    }
    wrap.addEventListener("pointerdown", function(e){
      stopPlay();
      dragging = true; moved = 0;
      startX = e.clientX; startPos = pos;
      samples = [{ t: performance.now(), p: pos }];
      wrap.classList.add("dragging");
      if (wrap.setPointerCapture){ try { wrap.setPointerCapture(e.pointerId); } catch(err){} }
    });
    wrap.addEventListener("pointermove", function(e){
      if (!dragging) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > moved) moved = Math.abs(dx);
      var w = wrap.clientWidth || 1;
      pos = startPos + (dx / w) * count();
      render();
      var now = performance.now();
      samples.push({ t: now, p: pos });
      while (samples.length > 2 && now - samples[0].t > 120) samples.shift();
    });
    function endDrag(e){
      if (!dragging) return;
      dragging = false; wrap.classList.remove("dragging");
      if (e && e.type === "pointerup" && moved > 6 && samples.length > 1){
        var dt = performance.now() - samples[0].t;
        if (dt > 16) startInertia((pos - samples[0].p) / dt);
      }
    }
    wrap.addEventListener("pointerup", endDrag);
    wrap.addEventListener("pointercancel", endDrag);
    wrap.addEventListener("keydown", function(e){
      if (e.key === "ArrowRight"){ pos = Math.round(pos) + 2; }
      else if (e.key === "ArrowLeft"){ pos = Math.round(pos) - 2; }
      else return;
      e.preventDefault();
      stopPlay();
      render();
    });
    render();
    return {
      wasDrag: function(){ return moved > 6; },
      stopPlay: stopPlay,
      reset: function(){ stopPlay(); pos = 0; render(); },
      setFrames: function(u){ stopPlay(); urls = u; pos = 0; lastIdx = -1; render(); }
    };
  }

  /* Pointer tilt for the grid portraits: tilts toward the cursor up to
     maxDeg, eased by lerping every frame (~400ms feel). Desktop fine
     pointer only; pauses while the portrait is off screen; never runs
     during a drag or for reduced motion. */
  function attachTilt(el, maxDeg){
    if (reduced || !finePointer || !el) return;
    var tRX = 0, tRY = 0, cRX = 0, cRY = 0, raf = null, hovering = false, isVisible = true;
    function loop(){
      raf = null;
      cRX += (tRX - cRX) * 0.11;
      cRY += (tRY - cRY) * 0.11;
      if (Math.abs(tRX - cRX) < 0.02) cRX = tRX;
      if (Math.abs(tRY - cRY) < 0.02) cRY = tRY;
      el.style.transform = "rotateX(" + cRX.toFixed(2) + "deg) rotateY(" + cRY.toFixed(2) + "deg)";
      if (hovering || Math.abs(cRX) > 0.02 || Math.abs(cRY) > 0.02){ raf = requestAnimationFrame(loop); }
      else { el.style.transform = ""; }
    }
    function kick(){ if (!raf && isVisible) raf = requestAnimationFrame(loop); }
    el.addEventListener("pointermove", function(e){
      if (e.pointerType && e.pointerType !== "mouse") return;
      if (el.classList.contains("dragging")) return;
      var r = el.getBoundingClientRect();
      if (!r.width) return;
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      tRY = px * 2 * maxDeg;
      tRX = -py * 2 * maxDeg;
      hovering = true;
      kick();
    });
    el.addEventListener("pointerleave", function(){
      hovering = false; tRX = 0; tRY = 0; kick();
    });
    if ("IntersectionObserver" in window){
      new IntersectionObserver(function(en){
        isVisible = en[0].isIntersecting;
        if (!isVisible && raf){ cancelAnimationFrame(raf); raf = null; }
        else if (isVisible) kick();
      }, { threshold: 0.05 }).observe(el);
    }
  }

  var gridFrame = document.getElementById("gridFrame");
  var gridWrap = document.getElementById("gridTurntable");
  var gridTT = attachTurntable(gridWrap, gridFrame, VAANI_PINK_URLS, null);
  gridWrap.addEventListener("click", function(){
    if (!gridTT.wasDrag() && gridWrap.closest(".cell").classList.contains("pos-center")) openProfile("vaani");
  });
  document.getElementById("vaaniNameBtn").addEventListener("click", function(){ openProfile("vaani"); });

  var ankitGridFrame = document.getElementById("ankitGridFrame");
  var ankitGridWrap = document.getElementById("ankitGridTurntable");
  var ankitGridTT = attachTurntable(ankitGridWrap, ankitGridFrame, ANKIT_LEATHER_URLS, null);
  ankitGridWrap.addEventListener("click", function(){
    if (!ankitGridTT.wasDrag() && ankitGridWrap.closest(".cell").classList.contains("pos-center")) openProfile("ankit");
  });
  document.getElementById("ankitNameBtn").addEventListener("click", function(){ openProfile("ankit"); });

  var carolineGridFrame = document.getElementById("carolineGridFrame");
  var carolineGridWrap = document.getElementById("carolineGridTurntable");
  var carolineGridTT = attachTurntable(carolineGridWrap, carolineGridFrame, CAROLINE_URLS, null);
  carolineGridWrap.addEventListener("click", function(){
    if (!carolineGridTT.wasDrag() && carolineGridWrap.closest(".cell").classList.contains("pos-center")) openProfile("caroline");
  });
  document.getElementById("carolineNameBtn").addEventListener("click", function(){ openProfile("caroline"); });

  var shreyaGridFrame = document.getElementById("shreyaGridFrame");
  var shreyaGridWrap = document.getElementById("shreyaGridTurntable");
  var shreyaGridTT = attachTurntable(shreyaGridWrap, shreyaGridFrame, SHREYA_CREAM_URLS, null);
  shreyaGridWrap.addEventListener("click", function(){
    if (!shreyaGridTT.wasDrag() && shreyaGridWrap.closest(".cell").classList.contains("pos-center")) openProfile("shreya");
  });
  document.getElementById("shreyaNameBtn").addEventListener("click", function(){ openProfile("shreya"); });

  attachTilt(gridWrap, 8);
  attachTilt(ankitGridWrap, 8);
  attachTilt(shreyaGridWrap, 8);
  attachTilt(carolineGridWrap, 8);

  /* ---------- HERO LANDSCAPE VIDEO SLIDER ----------
     Each slide is ONE model's landscape 360 video covering the FULL
     slider area (full-bleed, object-fit cover) at full quality - the
     mp4s are H.264 transcodes (crf 18, never downscaled) of the NEW
     1280x720 HEVC masters she sent on 2026-11-11, widened to
     1600x720 with the frame's own mirrored edges so the sides never
     show a different cut-out, and the Gemini sparkle watermark
     removed from every frame. The drag frames are 6fps stills from
     the same treated masters (JPEG q90, native quality kept). With
     cover fit the wide frame crops only at the sides on desktop,
     tablet and phone - the top and bottom are never cut. The hero
     is STATIC:
     no autoplay, no loop - each slide sits on its front frame at rest
     and only the active slide is on stage.
     A DRAG scrubs the full-res frame sequence under the finger so the
     model turns 360 (paused-video seeking is unreliable on iOS), and
     she stays on the frame where the finger left her - the video
     never resumes by itself. A quick TAP on the front slide (under
     ~6px movement) brings the NEXT model in; arrows, dots and the
     glass NEXT peek at the slider's right-centre do the same. There
     is no Play button: the video never plays - dragging the frames
     is the only way to turn a model. Each model's frames lazy-load
     only when her slide first becomes active. */
  var HERO_CFG = [
    { duration: 10, count: 60, dir: "assets/hero-vaani-landscape-frames" },
    { duration: 10, count: 60, dir: "assets/hero-ankit-landscape-frames" },
    { duration: 10, count: 60, dir: "assets/hero-shreya-landscape-frames" },
    { duration: 12, count: 72, dir: "assets/hero-caroline-landscape-frames" }
  ];
  var heroSlides = Array.prototype.slice.call(document.querySelectorAll(".hero-slide"));
  var heroDots = Array.prototype.slice.call(document.querySelectorAll(".hero-dot"));
  var heroActive = 0;
  var heroVisible = true;
  var heroCrossTimer = null;
  var heroStates = HERO_CFG.map(function(cfg, i){
    var slide = heroSlides[i];
    return {
      idx: i, cfg: cfg, slide: slide,
      media: slide.querySelector(".hero-media"),
      video: slide.querySelector(".hero-video"),
      frame: slide.querySelector(".hero-frame"),
      ambient: slide.querySelector(".hero-ambient"),
      frames: frameUrls(cfg.dir, cfg.count),
      loaded: false, pos: 0, dragging: false, playing: false,
      moved: 0, lastMoved: 0, startX: 0, startPos: 0,
      samples: [], inertiaRaf: null
    };
  });
  function ensureHeroFrames(i){
    var st = heroStates[i];
    if (st.loaded) return;
    st.loaded = true;
    queueFrames(st.frames);
  }
  function heroFrameIdx(st){
    var c = st.cfg.count;
    return ((Math.round(st.pos) % c) + c) % c;
  }
  function renderHeroFrame(st){
    var idx = heroFrameIdx(st);
    var src = st.frames[idx];
    if (st.frame.getAttribute("src") !== src) st.frame.src = src;
    /* The ambient side fill shows the same frame, blurred - it
       turns with her so the sides always match the video. */
    if (st.ambient && st.ambient.getAttribute("src") !== src) st.ambient.src = src;
    var deg = Math.round(idx / st.cfg.count * 360) % 360;
    st.media.setAttribute("aria-valuenow", deg);
    var nm = angleName(deg);
    st.media.setAttribute("aria-valuetext", nm.charAt(0).toUpperCase() + nm.slice(1) + " view");
  }
  /* Static hero: there is NO Play button - the slide's video never
     plays at all. stopHeroPlay simply parks a slide on its current
     frame with the video hidden and paused. The only way to turn a
     model is to drag left/right; a tap advances to the next model.
     Nothing ever autoplays. */
  function stopHeroPlay(st){
    st.playing = false;
    st.video.pause();
    st.video.hidden = true;
    st.frame.hidden = false;
    renderHeroFrame(st);
  }
  function stopHeroInertia(st){
    if (st.inertiaRaf){ cancelAnimationFrame(st.inertiaRaf); st.inertiaRaf = null; }
  }
  function resumeHeroFromFrame(st){
    /* Static hero: after a drag the model simply stays on the frame
       where the finger left her. The video never plays by itself -
       dragging is the only way she moves. */
  }
  function startHeroInertia(st, v0){
    var v = Math.max(-0.14, Math.min(0.14, v0));
    if (reduced || Math.abs(v) < 0.012){ resumeHeroFromFrame(st); return; }
    stopHeroInertia(st);
    var lastT = performance.now();
    function step(now){
      var dt = Math.min(50, now - lastT); lastT = now;
      st.pos += v * dt;
      v *= Math.exp(-dt / 170);
      renderHeroFrame(st);
      if (Math.abs(v) > 0.004){ st.inertiaRaf = requestAnimationFrame(step); }
      else { st.inertiaRaf = null; st.pos = Math.round(st.pos); renderHeroFrame(st); resumeHeroFromFrame(st); }
    }
    st.inertiaRaf = requestAnimationFrame(step);
  }
  function heroOffset(idx){
    /* Circular offset from the active slide: 0 centre, -1 left,
       1 right, and (with four slides) 2 directly behind. */
    var n = heroSlides.length;
    var off = ((idx - heroActive) % n + n) % n;
    if (off === n - 1) off = -1;
    return off;
  }
  /* The glass peek at the slider's right-centre always shows the NEXT
     model (portrait thumbnail + name + NEXT ->), looping
     Vaani -> Ankit -> Shreya -> Caroline -> Vaani. */
  var HERO_PEEK = [
    { name: "Vaani Garg", poster: "data:image/jpeg;base64," },
    { name: "Ankit Nigam", poster: "data:image/jpeg;base64,", him: true },
    { name: "Shreya D'Cruze", poster: "data:image/jpeg;base64," },
    { name: "Caroline Langford", poster: "data:image/jpeg;base64," }
  ];
  function updateHeroPeek(){
    var peek = document.getElementById("heroPeek");
    if (!peek) return;
    var info = HERO_PEEK[(heroActive + 1) % HERO_PEEK.length];
    var img = document.getElementById("heroPeekThumb");
    var nm = document.getElementById("heroPeekName");
    if (img && img.getAttribute("src") !== info.poster) img.src = info.poster;
    if (nm) nm.textContent = info.name;
    peek.setAttribute("aria-label", "Next model: " + info.name + " â€” show " + (info.him ? "him" : "her"));
  }
  function layoutHero(){
    heroSlides.forEach(function(slide, i){
      slide.classList.remove("pos-left", "pos-center", "pos-right", "pos-back");
      var off = heroOffset(i);
      slide.classList.add(off === 0 ? "pos-center" : (off === -1 ? "pos-left" : (off === 1 ? "pos-right" : "pos-back")));
      var media = heroStates[i].media;
      /* Only the active slide's media is a control; inactive slides
         carry no slider role at all (arrows / dots bring them in). */
      if (off === 0){ media.setAttribute("tabindex", "0"); media.setAttribute("role", "slider"); }
      else { media.setAttribute("tabindex", "-1"); media.removeAttribute("role"); }
    });
    heroDots.forEach(function(d, i){ d.classList.toggle("active", i === heroActive); });
    updateHeroPeek();
  }
  function setHeroActive(n){
    var next = ((n % heroSlides.length) + heroSlides.length) % heroSlides.length;
    if (next === heroActive){ layoutHero(); return; }
    var crosser = null;
    heroSlides.forEach(function(slide, i){
      var o = heroOffset(i);
      var n = heroSlides.length;
      var nw = ((i - next) % n + n) % n;
      if (nw === n - 1) nw = -1;
      if ((o === -1 || o === 1) && (nw === -1 || nw === 1) && o !== nw) crosser = slide;
    });
    var prev = heroStates[heroActive];
    stopHeroInertia(prev);
    prev.dragging = false;
    stopHeroPlay(prev);
    prev.pos = 0; renderHeroFrame(prev);
    heroActive = next;
    ensureHeroFrames(next);
    var ns = heroStates[next];
    stopHeroPlay(ns);
    ns.pos = 0; renderHeroFrame(ns);
    if (crosser && !reduced){
      crosser.classList.add("crossing");
      if (heroCrossTimer) clearTimeout(heroCrossTimer);
      heroCrossTimer = setTimeout(function(){
        heroCrossTimer = null;
        heroSlides.forEach(function(sl){ sl.classList.remove("crossing"); });
      }, 850);
    }
    layoutHero();
  }
  heroStates.forEach(function(st){
    st.video.addEventListener("timeupdate", function(){
      if (!st.dragging && !st.inertiaRaf && st.video.duration){
        st.pos = (st.video.currentTime / st.cfg.duration) * st.cfg.count;
      }
    });
    /* One play only: when the video ends, the slide returns to the
       static front frame. */
    st.video.addEventListener("ended", function(){
      st.pos = 0;
      stopHeroPlay(st);
    });
    st.media.addEventListener("pointerdown", function(e){
      if (st.idx !== heroActive) return;
      stopHeroInertia(st);
      st.dragging = true; st.moved = 0; st.lastMoved = 0;
      st.startX = e.clientX;
      /* Only while the video is actually playing is its clock the
         current angle; when parked on a frame, st.pos already is. */
      if (st.playing && st.video.duration) st.pos = (st.video.currentTime / st.cfg.duration) * st.cfg.count;
      st.startPos = st.pos;
      st.samples = [{ t: performance.now(), p: st.pos }];
      stopHeroPlay(st);
      renderHeroFrame(st);
      st.media.classList.add("dragging");
      if (st.media.setPointerCapture){ try { st.media.setPointerCapture(e.pointerId); } catch(err){} }
    });
    st.media.addEventListener("pointermove", function(e){
      if (!st.dragging) return;
      var dx = e.clientX - st.startX;
      if (Math.abs(dx) > st.moved) st.moved = Math.abs(dx);
      var w = st.media.clientWidth || 1;
      st.pos = st.startPos + (dx / w) * st.cfg.count;
      renderHeroFrame(st);
      var now = performance.now();
      st.samples.push({ t: now, p: st.pos });
      while (st.samples.length > 2 && now - st.samples[0].t > 120) st.samples.shift();
    });
    function endHeroDrag(e){
      if (!st.dragging) return;
      st.dragging = false;
      st.media.classList.remove("dragging");
      st.lastMoved = st.moved;
      if (e && e.type === "pointerup" && st.moved > 6){
        var dt = performance.now() - st.samples[0].t;
        if (dt > 16 && st.samples.length > 1){ startHeroInertia(st, (st.pos - st.samples[0].p) / dt); return; }
        resumeHeroFromFrame(st);
      } else if (st.moved > 6){
        resumeHeroFromFrame(st);
      }
      /* A tap (moved <= 6) leaves the poster frame up; the click that
         follows advances the slider, which hides it again. */
    }
    st.media.addEventListener("pointerup", endHeroDrag);
    st.media.addEventListener("pointercancel", endHeroDrag);
    st.media.addEventListener("keydown", function(e){
      if (st.idx !== heroActive) return;
      if (e.key === "ArrowRight" || e.key === "ArrowLeft"){
        e.preventDefault();
        stopHeroInertia(st);
        if (st.playing && st.video.duration) st.pos = (st.video.currentTime / st.cfg.duration) * st.cfg.count;
        stopHeroPlay(st);
        st.pos = Math.round(st.pos) + (e.key === "ArrowRight" ? 3 : -3);
        renderHeroFrame(st);
      } else if (e.key === "Enter" || e.key === " "){
        e.preventDefault();
        setHeroActive(heroActive + 1);
      }
    });
    st.slide.addEventListener("click", function(){
      if (!st.slide.classList.contains("pos-center")){
        setHeroActive(st.idx);
        return;
      }
      if (st.lastMoved > 6) { st.lastMoved = 0; return; }
      setHeroActive(heroActive + 1);
    });
  });
  document.getElementById("heroPrev").addEventListener("click", function(){ setHeroActive(heroActive - 1); });
  document.getElementById("heroNext").addEventListener("click", function(){ setHeroActive(heroActive + 1); });
  heroDots.forEach(function(d, i){
    d.addEventListener("click", function(){ setHeroActive(i); });
  });
  if ("IntersectionObserver" in window){
    new IntersectionObserver(function(en){
      heroVisible = en[0].isIntersecting;
      /* Never autoplay on visibility - only park a playing video. */
      if (!heroVisible) heroStates.forEach(function(st){ if (st.playing) stopHeroPlay(st); });
    }, { threshold: 0.05 }).observe(document.getElementById("heroStage"));
  }
  var heroPeekEl = document.getElementById("heroPeek");
  if (heroPeekEl) heroPeekEl.addEventListener("click", function(){ setHeroActive(heroActive + 1); });
  /* Warm Vaani's hero frames and the grid turntables through the
     gentle queue so the first drag is smooth; a drag before they
     land simply streams the frames on demand. */
  heroStates.forEach(function(st){ stopHeroPlay(st); st.pos = 0; renderHeroFrame(st); });
  layoutHero();
  ensureHeroFrames(0);
  warmGridFrames();


  /* ---------- VISIBLE 3D STAGE (coverflow) ----------
     The four grid portraits live in one perspective scene. The front
     model faces forward (drag-to-rotate turntable + tap opens profile,
     handled above); the side models angle away, pushed back, smaller,
     lower and blurred 2px; a model crossing from one side to the other
     passes BEHIND the centre, smaller still and blurred 4px. Tapping a
     side model, the arrows, the dots, or a swipe on the stage swings a
     new model to the front (0.8s, cubic-bezier(0.16,1,0.3,1); role
     crossfade 650ms, cubic-bezier(0.4,0,0.2,1)). No autoplay: the stage
     only moves on interaction. Shreya starts at the front, matching the
     hero strip's centre panel. */
  var stageEl = document.getElementById("stage");
  var stageCells = cells;
  var stageActive = 2;
  var stageFiltered = false;
  var stageDots = Array.prototype.slice.call(document.querySelectorAll("#stageControls .stage-dot"));
  var stageControls = document.getElementById("stageControls");
  var crossTimer = null;
  function stageOffset(idx){
    /* Wrap the offset around the ring of models: with three on stage
       the far model sits on the opposite side; with four, the far
       model sits at the back (offset Â±2). */
    var n = stageCells.length;
    var off = idx - stageActive;
    while (off > n / 2) off -= n;
    while (off < -n / 2) off += n;
    return off;
  }
  function layoutStage(){
    var vis = stageCells.filter(function(c){ return !c.classList.contains("hide"); });
    stageCells.forEach(function(cell, i){
      cell.classList.remove("pos-left", "pos-center", "pos-right", "pos-back", "is-center");
      if (cell.classList.contains("hide")) return;
      var off;
      if (vis.length === 3 || vis.length === 4) off = stageOffset(i);
      else {
        var ai = vis.indexOf(stageCells[stageActive]);
        if (ai < 0) ai = 0;
        off = vis.indexOf(cell) - ai;
      }
      if (off === 0) cell.classList.add("pos-center", "is-center");
      else if (off === -1) cell.classList.add("pos-left");
      else if (off === 1) cell.classList.add("pos-right");
      else cell.classList.add("pos-back");
    });
    stageDots.forEach(function(d, i){ d.classList.toggle("active", i === stageActive); });
    if (stageControls) stageControls.style.display = stageFiltered ? "none" : "";
  }
  function setStageActive(n){
    var next = ((n % stageCells.length) + stageCells.length) % stageCells.length;
    if (next === stageActive){ layoutStage(); return; }
    /* The model whose side flips (left<->right) crosses behind the centre. */
    var crosser = null;
    var nCells = stageCells.length;
    stageCells.forEach(function(cell, i){
      var o = stageOffset(i);
      var nw = i - next;
      while (nw > nCells / 2) nw -= nCells;
      while (nw < -nCells / 2) nw += nCells;
      if ((o === -1 && nw === 1) || (o === 1 && nw === -1)) crosser = cell;
    });
    stageActive = next;
    if (crosser && !reduced){
      crosser.classList.add("crossing");
      if (crossTimer) clearTimeout(crossTimer);
      crossTimer = setTimeout(function(){
        crossTimer = null;
        stageCells.forEach(function(c){ c.classList.remove("crossing"); });
      }, 850);
    }
    layoutStage();
  }
  function refreshStage(filtered){
    stageFiltered = !!filtered;
    layoutStage();
  }
  /* Every stage model is a live turntable: dragging ANY of them rotates
     her 360Â°, wherever she sits. A tap on a side model brings her to
     the front; a tap on the front model opens her profile (handled by
     the turntable click above). A drag must do neither, so the capture
     handler checks the turntable's drag guard first. */
  var stageTTs = [gridTT, ankitGridTT, shreyaGridTT, carolineGridTT];
  stageCells.forEach(function(cell, i){
    cell.addEventListener("click", function(e){
      if (cell.classList.contains("pos-center")) return;
      e.preventDefault();
      e.stopPropagation();
      if (stageTTs[i] && stageTTs[i].wasDrag()) return;
      setStageActive(i);
    }, true);
  });
  document.getElementById("stagePrev").addEventListener("click", function(){ setStageActive(stageActive - 1); });
  document.getElementById("stageNext").addEventListener("click", function(){ setStageActive(stageActive + 1); });
  stageDots.forEach(function(d, i){
    d.addEventListener("click", function(){ setStageActive(i); });
  });
  /* Swipe on the stage background rotates the stage too. A swipe
     starting on ANY model belongs to her turntable (drag rotates her),
     never to the stage. */
  var swipeX = null;
  stageEl.addEventListener("touchstart", function(e){
    var c = e.target && e.target.closest ? e.target.closest(".cell") : null;
    swipeX = c ? null : e.touches[0].clientX;
  }, { passive: true });
  stageEl.addEventListener("touchend", function(e){
    if (swipeX === null) return;
    var dx = e.changedTouches[0].clientX - swipeX;
    swipeX = null;
    if (Math.abs(dx) > 40) setStageActive(stageActive + (dx < 0 ? 1 : -1));
  }, { passive: true });
  stageEl.addEventListener("keydown", function(e){
    /* Arrow keys on a turntable slider rotate her frames, not the stage. */
    if (e.target && e.target.closest && e.target.closest(".tt")) return;
    if (e.key === "ArrowRight"){ e.preventDefault(); setStageActive(stageActive + 1); }
    else if (e.key === "ArrowLeft"){ e.preventDefault(); setStageActive(stageActive - 1); }
  });
  layoutStage();

  /* ---------- profile overlay ---------- */
  var overlay = document.getElementById("overlay");
  var ovName = document.getElementById("ovName");
  var ovNiche = document.getElementById("ovNiche");
  var ovMain = document.getElementById("ovMain");
  var ovHero = document.getElementById("ovHero");
  var ovHeight = document.getElementById("ovHeight");
  var ovGender = document.getElementById("ovGender");
  var ovAge = document.getElementById("ovAge");
  var ovEthnicity = document.getElementById("ovEthnicity");
  var ovBased = document.getElementById("ovBased");
  var ovStory = document.getElementById("ovStory");
  var ovTags = document.getElementById("ovTags");
  var ovGal = document.getElementById("ovGal");
  var ovGalLabel = document.getElementById("ovGalLabel");
  var ovWorkLabel = document.getElementById("ovWorkLabel");
  var ovWork = document.getElementById("ovWork");
  var ovBook = document.getElementById("ovBook");
  var lastFocus = null;

  function openProfile(id){
    var m = MODELS[id];
    if (!m) return;
    lastFocus = document.activeElement;
    ovName.textContent = m.name;
    ovNiche.innerHTML = "";
    var b = document.createElement("b");
    b.textContent = m.niche;
    ovNiche.appendChild(b);
    if (ovHeight) ovHeight.textContent = "HEIGHT " + (m.height || "");
    if (ovGender) ovGender.textContent = m.gender || "FEMALE";
    if (ovAge){
      ovAge.textContent = m.age ? "AGE " + m.age : "";
      ovAge.style.display = m.age ? "" : "none";
    }
    if (ovEthnicity) ovEthnicity.textContent = m.ethnicity ? "ETHNICITY Â· " + m.ethnicity.toUpperCase() : "";
    if (ovBased) ovBased.textContent = m.based ? "BASED IN Â· " + m.based.toUpperCase() : "";
    /* Main top part: the hero photo is the SAME feature image the
       All Models list uses for this model. */
    if (ovHero){
      ovHero.src = m.feature || m.main;
      ovHero.alt = m.featureAlt || m.mainAlt;
    }
    ovMain.src = m.main;
    ovMain.alt = m.mainAlt;
    ovStory.textContent = m.story;
    ovTags.textContent = m.tags.join("  Â·  ");
    ovBook.setAttribute("data-book", m.name);
    ovGal.innerHTML = "";
    var gallery = m.gallery || [];
    if (ovGalLabel) ovGalLabel.hidden = !gallery.length;
    ovGal.hidden = !gallery.length;
    gallery.forEach(function(g){
      var img = document.createElement("img");
      img.src = g[0];
      img.alt = g[1];
      img.loading = "lazy";
      ovGal.appendChild(img);
    });
    /* Work gallery: only models with a work set show the section.
       Each photo is a button that opens the glass lightbox on the
       original, full-clarity file. */
    var work = m.work || [];
    ovWorkLabel.hidden = !work.length;
    ovWork.innerHTML = "";
    work.forEach(function(w, i){
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "work-item";
      btn.setAttribute("aria-label", "View at full size: " + w[1]);
      var ph = document.createElement("span");
      ph.className = "ph";
      var wimg = document.createElement("img");
      wimg.src = w[0];
      wimg.alt = w[2];
      wimg.loading = "lazy";
      ph.appendChild(wimg);
      var cap = document.createElement("span");
      cap.className = "work-cap";
      cap.textContent = w[1];
      btn.appendChild(ph);
      btn.appendChild(cap);
      btn.addEventListener("click", function(){ openLightbox(work, i); });
      ovWork.appendChild(btn);
    });
    overlay.classList.add("on");
    overlay.classList.remove("play-in");
    if (!reduced){ void overlay.offsetWidth; overlay.classList.add("play-in"); }
    overlay.scrollTop = 0;
    document.body.style.overflow = "hidden";
    document.getElementById("ovClose").focus();
  }
  function closeProfile(){
    overlay.classList.remove("on");
    overlay.classList.remove("play-in");
    document.body.style.overflow = "";
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  cells.forEach(function(c){
    c.addEventListener("click", function(){ openProfile(c.getAttribute("data-open")); });
  });
  document.getElementById("ovClose").addEventListener("click", closeProfile);
  /* The ALL MODELS list rows open the same full profiles as the
     stage models and hero slides. */
  Array.prototype.forEach.call(document.querySelectorAll("[data-model-open]"), function(el){
    el.addEventListener("click", function(){ openProfile(el.getAttribute("data-model-open")); });
  });
  document.addEventListener("keydown", function(e){
    if (e.key === "Escape" && !lightbox.hidden) return;
    if (e.key === "Escape" && overlay.classList.contains("on")) closeProfile();
  });

  /* ---------- frosted-glass lightbox (work gallery) ----------
     Shows the ORIGINAL file uncropped (the frame uses contain),
     so the photo is seen at full clarity. Prev/next arrows,
     keyboard arrows, swipe, backdrop click, the close button
     and ESC all work; ESC here is swallowed by the profile's
     own handler above so the profile stays open underneath. */
  var lightbox = document.getElementById("lightbox");
  var lbImg = document.getElementById("lbImg");
  var lbCap = document.getElementById("lbCap");
  var lbCount = document.getElementById("lbCount");
  var lbItems = [];
  var lbIndex = 0;
  var lbLastFocus = null;

  function lbShow(i){
    if (!lbItems.length) return;
    lbIndex = (i + lbItems.length) % lbItems.length;
    var w = lbItems[lbIndex];
    lbImg.src = w[0];
    lbImg.alt = w[2];
    lbCap.textContent = w[1];
    lbCount.textContent = (lbIndex + 1) + " / " + lbItems.length;
    /* Warm the neighbours so arrowing feels instant. */
    [lbIndex - 1, lbIndex + 1].forEach(function(n){
      var pre = new Image();
      pre.src = lbItems[(n + lbItems.length) % lbItems.length][0];
    });
  }
  function openLightbox(items, i){
    lbItems = items;
    lbLastFocus = document.activeElement;
    lightbox.hidden = false;
    lbShow(i);
    document.getElementById("lbClose").focus();
  }
  function closeLightbox(){
    lightbox.hidden = true;
    lbImg.removeAttribute("src");
    if (lbLastFocus && lbLastFocus.focus) lbLastFocus.focus();
  }
  document.getElementById("lbClose").addEventListener("click", closeLightbox);
  document.getElementById("lbPrev").addEventListener("click", function(){ lbShow(lbIndex - 1); });
  document.getElementById("lbNext").addEventListener("click", function(){ lbShow(lbIndex + 1); });
  lightbox.addEventListener("click", function(e){ if (e.target === lightbox) closeLightbox(); });
  document.addEventListener("keydown", function(e){
    if (lightbox.hidden) return;
    if (e.key === "Escape") closeLightbox();
    else if (e.key === "ArrowRight"){ e.preventDefault(); lbShow(lbIndex + 1); }
    else if (e.key === "ArrowLeft"){ e.preventDefault(); lbShow(lbIndex - 1); }
  });
  var lbTouchX = null;
  lightbox.addEventListener("touchstart", function(e){ lbTouchX = e.touches[0].clientX; }, { passive:true });
  lightbox.addEventListener("touchend", function(e){
    if (lbTouchX === null) return;
    var dx = e.changedTouches[0].clientX - lbTouchX;
    lbTouchX = null;
    if (Math.abs(dx) > 40) lbShow(lbIndex + (dx < 0 ? 1 : -1));
  }, { passive:true });
  ovBook.addEventListener("click", function(){
    var name = ovBook.getAttribute("data-book");
    var sel = document.getElementById("fModel");
    for (var i = 0; i < sel.options.length; i++){
      if (sel.options[i].text === name){ sel.selectedIndex = i; break; }
    }
    closeProfile();
  });

  /* ---------- enquiry copy ---------- */
  document.getElementById("copyBtn").addEventListener("click", function(){
    var model = document.getElementById("fModel").value;
    var brand = document.getElementById("fBrand").value.trim();
    var product = document.getElementById("fProduct").value.trim();
    var msg = document.getElementById("fMsg").value.trim();
    var lines = ["Booking enquiry â€” The Unreal Human (theunrealhuman.tech)", "", "Model: " + model];
    lines[2] = "Model / service: " + model;
    if (brand) lines.push("Brand: " + brand);
    if (product) lines.push("Product / campaign: " + product);
    if (msg) lines.push("", msg);
    var text = lines.join("\n");
    var status = document.getElementById("copyStatus");
    function done(){ status.textContent = "Copied â€” your enquiry is ready to paste and send."; }
    function fallback(){
      var ta = document.createElement("textarea");
      ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
      document.body.appendChild(ta); ta.select();
      try { document.execCommand("copy"); done(); }
      catch(e){ status.textContent = "Copy didn't work here â€” your enquiry text is: " + text; }
      document.body.removeChild(ta);
    }
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(done, fallback);
    } else fallback();
  });
})();
</script>
</body>
</html>
